# 复制成 .env.local 后按需修改。什么都不配也能跑：默认读 examples/sample-vault。

# ---- 本地 vault 模式（可选）----
# HEALTH_VAULT_DIR=/path/to/your/vault
# PERSONAL_SUBDIR=Personal

# ---- 本地云端模式（登录、MCP、写入）：先 pnpm db:up && pnpm db:migrate ----
# DATABASE_URL=postgres://kzh:kzh@127.0.0.1:5433/kzh
# 两个密钥都用 openssl rand -base64 32 现生成，只用于本地
# KZ_MASTER_KEY=
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# 不配 RESEND_API_KEY 时，登录验证码打印在开发服务器控制台；Google 登录可不配
# 部署自己的实例见 docs/self-hosting.md
