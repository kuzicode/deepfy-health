{
  "name": "deepfy-health",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "kzh": "tsx src/cli/kzh.ts",
    "health": "knip --no-exit-code; jscpd src app --silent --exit-code 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:up": "docker compose -f compose.dev.yml up -d",
    "test:db": "KZ_TEST_DATABASE_URL=${KZ_TEST_DATABASE_URL:-postgres://kzh:kzh@127.0.0.1:5433/kzh_test} vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.66.0",
    "marked": "^18.1.2",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "postgres": "4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sanitize-html": "2.18.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.14.0",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
